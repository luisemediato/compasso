{
  "name": "compasso",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "start": "node scripts/serve.js",
    "db:generate": "drizzle-kit generate",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:coverage": "c8 node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "worker:dev": "npm run build && wrangler dev --local",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:parallel": "playwright test --workers=4",
    "test:smoke": "node scripts/smoke.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisemediato/compasso.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/luisemediato/compasso/issues"
  },
  "homepage": "https://github.com/luisemediato/compasso#readme",
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "c8": "^10.1.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "wrangler": "4.166.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
